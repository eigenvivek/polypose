---
interface Props {
  source: string;
}

const { source } = Astro.props;
---

<div class="w-full flex justify-center py-6">
  <video
    class="max-w-full h-auto rounded-lg"
    autoplay
    controls
    muted
    loop
    playsinline
  >
    <source src={source} type="video/mp4" />
  </video>
</div>
