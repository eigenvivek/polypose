---
import LaTeX from '../components/LaTeX.astro'; // adjust path as needed

interface Props {
  htmlFiles: string[];
  titles: string[];
  gap?: string;
}

const {
  htmlFiles,
  titles,
  gap = "1rem"
} = Astro.props;

if (htmlFiles.length !== titles.length) {
  throw new Error("The length of 'htmlFiles' and 'titles' must be the same.");
}
---

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--gap);
    width: 100%;
  }

  .frame-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .iframe-container {
    position: relative;
    width: 100%;
    padding-top: 100%;
    overflow: hidden;
  }

  .iframe-title-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background-color: #e0f0ff;
    border-bottom: 2px solid #3399ff;
    color: #003366;
    padding: 0.5rem;
    text-align: center;
    font-weight: bold;
    font-size: 0.95rem;
    z-index: 2;
  }

  iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 1px solid #ccc;
    border-radius: 6px;
    z-index: 1;
  }
</style>

<div class="grid" style={`--gap: ${gap}`}>
  {htmlFiles.map((src, index) => (
    <div class="frame-wrapper">
      <div class="iframe-container">
        <div class="iframe-title-overlay">{titles[index]}</div>
        <iframe src={src} loading="lazy" />
      </div>
    </div>
  ))}
</div>
